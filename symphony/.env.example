# Symphony — 환경변수 템플릿
#
# 사용법:
#   1) 이 파일을 .env 로 복사
#   2) 실제 값 채우기
#   3) .env 는 절대 커밋하지 않는다 (.gitignore 됨)
#
# 앱이 시작될 때 python-dotenv 가 .env 를 읽어 os.environ 에 넣는다.
# 이후 subprocess(claude, git 등)가 자동으로 상속한다.

# ── DB API (작업 조회·상태변경) ─────────────────────────────────
DB_API_BASE_URL=https://your-db-api.example.com
DB_API_TOKEN=

# ── git 레포 (워크스페이스 clone 대상) ──────────────────────────
REPO_URL=git@github.com:your-org/your-repo.git
# 또는 HTTPS + 토큰:
# REPO_URL=https://x-access-token:${GITHUB_TOKEN}@github.com/your-org/your-repo.git
GITHUB_TOKEN=

# ── Claude skill 용 외부 자격증명 ──────────────────────────────
# Claude 가 skill 안에서 curl/bash 로 이 값들을 그대로 쓴다.
# Atlassian Jira (이메일 + API 토큰 = Basic auth)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# 예: Slack webhook
# SLACK_WEBHOOK_URL=

# 예: 사내 모니터링/로그 API
# OBSERVABILITY_API_TOKEN=
